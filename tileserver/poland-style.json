{
  "version": 8,
  "name": "PolandVector",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "mbtiles://{poland}"
    }
  },
  "sprite": "",
  "glyphs": "https://cdn.jsdelivr.net/npm/maplibre-gl@2.4.0/dist/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#ddeeff" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": { "fill-color": "#a0c8f0" }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "paint": { "fill-color": "#eae0d0" }
    },
    {
      "id": "grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", "class", "grass"],
      "paint": { "fill-color": "#82c784", "fill-opacity": 0.5 }
    },
    {
      "id": "wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", "class", "wood"],
      "paint": { "fill-color": "#3b7a57", "fill-opacity": 0.6 }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "paint": { "line-color": "#999999", "line-width": 1 }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "paint": { "fill-color": "#bbbbbb" }
    }
  ]
}
